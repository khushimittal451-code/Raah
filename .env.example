# Public local defaults only. Never place secrets in VITE_ variables.
# Example file is documentation; shells do not load it automatically.
RAAH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Read by Vite dev server (shell environment); /api is rewritten to this target.
RAAH_API_TARGET=http://127.0.0.1:8000
# Optional standalone SUMO smoke adapter only; main API never imports it.
RAAH_ENABLE_SUMO=0
# If installed outside PATH, set SUMO_HOME to its installation root (contains bin/).
# SUMO_HOME=C:/path/to/sumo
